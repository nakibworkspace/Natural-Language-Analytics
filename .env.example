# Lab environment variables. Copy this to .env and edit as needed.
# NEVER commit .env to source control.

# ---------------------- PostgreSQL ----------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ride_analytics

# Superuser (used only by docker-compose init; the analytics skills MUST NOT use this)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Read-only analytics role (the skills use this)
POSTGRES_READER_USER=analytics_reader
POSTGRES_READER_PASSWORD=analytics_reader_pw

# ---------------------- Metabase ----------------------
METABASE_URL=http://localhost:3000
METABASE_PORT=3000

# Metabase admin credentials. Used by the dashboard skill to log in via
# /api/session (or to bootstrap the admin via /api/setup on a fresh
# Metabase H2 DB). On the very first run, no browser setup is required —
# `tools/metabase_provision.py` creates this user via the same REST API
# that the setup wizard would call.
#
# If you point METABASE_URL at a Metabase instance that already has an
# admin user (different credentials), update these two lines to match.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Admin123!

# Metabase API key. LEAVE EMPTY the first time you run the lab.
# The dashboard skill will:
#   1. POST /api/setup (only on a fresh H2 DB) to create the admin user
#      + connect Postgres in a single server-side call — NO BROWSER.
#   2. POST /api/session to obtain a session id
#   3. POST /api/database to ensure Postgres is connected
#   4. POST /api/api-key to create an API key named "ride-analytics-bot"
#   5. Persist the key back into this .env file
# Subsequent runs reuse the persisted key. If the key is ever invalid
# (e.g. the metabase-data volume was wiped), the same flow re-runs.
METABASE_API_KEY=

# Postgres connection that Metabase will use (auto-added on first run).
# Defaults to the docker-compose service name `postgres` if Metabase is
# running inside the same Docker network as Postgres. If Metabase runs
# outside Docker (e.g. behind a load balancer in a VM), set this to the
# host's reachable address (`host.docker.internal` on Docker Desktop,
# or the VM's IP).
METABASE_PG_HOST=postgres
METABASE_PG_PORT=5432
METABASE_PG_DB=ride_analytics
METABASE_PG_USER=postgres
METABASE_PG_PASSWORD=postgres

# ---------------------- Skill behavior ----------------------
# Query timeout in milliseconds for SQL execution
SQL_QUERY_TIMEOUT_MS=15000
# Hard row cap for any single query
SQL_MAX_ROWS=10000
